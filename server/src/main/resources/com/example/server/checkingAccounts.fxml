<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextArea?>

<GridPane xmlns="http://javafx.com/javafx/17.0.12"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="com.example.server.controller.LogController"
          stylesheets="@css/dashboard.css"
          styleClass="root-pane"
          hgap="16.0"
          vgap="12.0">
    <padding>
        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
    </padding>

    <columnConstraints>
        <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS" />
        <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS" />
    </columnConstraints>

    <rowConstraints>
        <RowConstraints percentHeight="50.0" vgrow="ALWAYS" />
        <RowConstraints percentHeight="50.0" vgrow="ALWAYS" />
    </rowConstraints>

    <VBox spacing="6.0"
          GridPane.columnIndex="1"
          GridPane.rowIndex="0"
          maxWidth="Infinity"
          maxHeight="Infinity">
        <Label text="Terminale Server" styleClass="section-title" />
        <ListView fx:id="serverLogView"
                  styleClass="terminal-view"
                  VBox.vgrow="ALWAYS"
                  maxWidth="Infinity"
                  maxHeight="Infinity"
        />
    </VBox>

    <VBox spacing="6.0"
          GridPane.columnIndex="0"
          GridPane.rowIndex="0"
          maxWidth="Infinity"
          maxHeight="Infinity">
        <Label text="Inbox" styleClass="section-title" />
        <ListView fx:id="inboxView"
                  VBox.vgrow="ALWAYS"
                  maxWidth="Infinity"
                  maxHeight="Infinity"
        />
    </VBox>

    <VBox spacing="6.0"
          GridPane.columnIndex="0"
          GridPane.rowIndex="1"
          maxWidth="Infinity"
          maxHeight="Infinity">
        <Label text="Elenco mail" styleClass="section-title" />
        <TextArea fx:id="mailView"
                  styleClass="mail-detail-view"
                  editable="false"
                  wrapText="true"
                  VBox.vgrow="ALWAYS"
                  maxWidth="Infinity"
                  maxHeight="Infinity"
        />
    </VBox>
</GridPane>